{
  "vectorFormat": "persona-conformance-vectors",
  "vectorFormatVersion": 1,
  "kind": "payload.binary.encode",
  "description": "Byte-exact persona-binary encodings of the built-in envelope schemas of §5, so a different implementation can check its envelope serialization independently of any signing behaviour. The runner resolves each schemaRef through its own built-in schema registration, which is itself pinned by the schema.digest vectors.",
  "spec": [
    "docs/SCHEMA.md §5",
    "docs/SCHEMA.md §3.2"
  ],
  "vectors": [
    {
      "id": "envelope/binary-encode/signed-envelope",
      "spec": "docs/SCHEMA.md §5",
      "description": "A SignedEnvelope record with one signature. The wire shape is the record of persona.SignedEnvelope@v1: six fields in declaration order, 'payload' and every signature 'value' as length-prefixed byte strings.",
      "schemaRef": "persona.SignedEnvelope@v1",
      "value": {
        "messageType": "example.Greeting@v1",
        "payloadFormat": "json",
        "schemaId": "66cd4cc7f890f80cbda43fa5d69efeccadad0833",
        "payload": "AQID",
        "signedBy": "alice",
        "signatures": [
          {
            "algorithm": "SHA256withRSA",
            "value": "CQg="
          }
        ]
      },
      "expectedHex": "266578616d706c652e4772656574696e67407631086a736f6e5036366364346363376638393066383063626461343366613564363965666563636164616430383333060102030a616c696365021a5348413235367769746852534104090800"
    },
    {
      "id": "envelope/binary-encode/signed-envelope-two-signatures",
      "spec": "docs/SCHEMA.md §5",
      "description": "A pinned signedBy, an empty payload and two signatures: the signatures array is one block of two inline Signature records.",
      "schemaRef": "persona.SignedEnvelope@v1",
      "value": {
        "messageType": "example.Greeting@v1",
        "payloadFormat": "persona-binary",
        "schemaId": "66cd4cc7f890f80cbda43fa5d69efeccadad0833",
        "payload": "",
        "signedBy": "alice#aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "signatures": [
          {
            "algorithm": "SHA256withRSA",
            "value": "AA=="
          },
          {
            "algorithm": "SHA256withRSA",
            "value": "////"
          }
        ]
      },
      "expectedHex": ""
    },
    {
      "id": "envelope/binary-encode/signed-envelope-empty-signatures-and-empty-schema-id",
      "spec": "docs/SCHEMA.md §5",
      "description": "An absent schemaId is the empty string on the wire (§5), an empty signatures array is a lone zero terminator.",
      "schemaRef": "persona.SignedEnvelope@v1",
      "value": {
        "messageType": "persona.Alert@v1",
        "payloadFormat": "json",
        "schemaId": "",
        "payload": "",
        "signedBy": "any",
        "signatures": []
      },
      "expectedHex": "20706572736f6e612e416c657274407631086a736f6e000006616e7900"
    },
    {
      "id": "envelope/binary-encode/multi-signed-envelope",
      "spec": "docs/SCHEMA.md §5",
      "description": "Two signers, the first with two signatures: the outer signatures array holds inline MultiSignature records, each with its own inner signatures array.",
      "schemaRef": "persona.MultiSignedEnvelope@v1",
      "value": {
        "messageType": "example.Charter@v1",
        "payloadFormat": "persona-binary",
        "schemaId": "66cd4cc7f890f80cbda43fa5d69efeccadad0833",
        "payload": "AQI=",
        "signatures": [
          {
            "signedBy": "alice",
            "signatures": [
              {
                "algorithm": "SHA256withRSA",
                "value": "Bw=="
              },
              {
                "algorithm": "SHA256withRSA",
                "value": "CAk="
              }
            ]
          },
          {
            "signedBy": "bob",
            "signatures": [
              {
                "algorithm": "SHA256withRSA",
                "value": "Cgs="
              }
            ]
          }
        ]
      },
      "expectedHex": "246578616d706c652e436861727465724076311c706572736f6e612d62696e6172795036366364346363376638393066383063626461343366613564363965666563636164616430383333040102040a616c696365041a5348413235367769746852534102071a534841323536776974685253410408090006626f62021a53484132353677697468525341040a0b0000"
    },
    {
      "id": "envelope/binary-encode/multi-signed-envelope-empty-inner-signatures",
      "spec": "docs/SCHEMA.md §5",
      "description": "An inner signatures array may be empty; the outer array still holds one entry.",
      "schemaRef": "persona.MultiSignedEnvelope@v1",
      "value": {
        "messageType": "example.Charter@v1",
        "payloadFormat": "json",
        "schemaId": "66cd4cc7f890f80cbda43fa5d69efeccadad0833",
        "payload": "AQID",
        "signatures": [
          {
            "signedBy": "alice",
            "signatures": []
          }
        ]
      },
      "expectedHex": "246578616d706c652e43686172746572407631086a736f6e503636636434636337663839306638306362646134336661356436396566656363616461643038333306010203020a616c6963650000"
    },
    {
      "id": "envelope/binary-encode/signature-record",
      "spec": "docs/SCHEMA.md §5",
      "description": "The standalone persona.Signature@v1 record, which exists for digest stability testing (§5).",
      "schemaRef": "persona.Signature@v1",
      "value": {
        "algorithm": "SHA256withRSA",
        "value": "AAECAwQFBgcICQ=="
      },
      "expectedHex": "1a534841323536776974685253411400010203040506070809"
    },
    {
      "id": "envelope/binary-encode/signature-record-empty-value",
      "spec": "docs/SCHEMA.md §5",
      "description": "A zero-length signature value is representable.",
      "schemaRef": "persona.Signature@v1",
      "value": {
        "algorithm": "SHA256withRSA",
        "value": ""
      },
      "expectedHex": "1a5348413235367769746852534100"
    },
    {
      "id": "envelope/binary-encode/multi-signature-record",
      "spec": "docs/SCHEMA.md §5",
      "description": "The standalone persona.MultiSignature@v1 record with two inline Signature items.",
      "schemaRef": "persona.MultiSignature@v1",
      "value": {
        "signedBy": "alice",
        "signatures": [
          {
            "algorithm": "SHA256withRSA",
            "value": "Bw=="
          },
          {
            "algorithm": "SHA256withRSA",
            "value": "CAk="
          }
        ]
      },
      "expectedHex": "0a616c696365041a5348413235367769746852534102071a5348413235367769746852534104080900"
    },
    {
      "id": "envelope/binary-encode/multi-signature-record-empty-signatures",
      "spec": "docs/SCHEMA.md §5",
      "description": "An empty signatures array inside a MultiSignature.",
      "schemaRef": "persona.MultiSignature@v1",
      "value": {
        "signedBy": "bob",
        "signatures": []
      },
      "expectedHex": "06626f6200"
    }
  ]
}
