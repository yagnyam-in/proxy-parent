    {
      "id": "binary/primitive-encode/string-foo",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "Primitive encoding of §3.1.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"string\"}]}",
      "value": {
        "v": "foo"
      },
      "expectedHex": "06666f6f"
    },
    {
      "id": "binary/primitive-encode/string-two-byte-utf8",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "The length prefix counts UTF-8 bytes, not characters: U+00E9 is two bytes.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"string\"}]}",
      "value": {
        "v": "é"
      },
      "expectedHex": "04c3a9"
    },
    {
      "id": "binary/primitive-encode/string-escapes",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "The length prefix counts the six raw bytes; no escaping happens in the binary format.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"string\"}]}",
      "value": {
        "v": "a\"b\\c\n"
      },
      "expectedHex": "0c6122625c630a"
    },
    {
      "id": "binary/primitive-encode/string-astral-plane",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "U+1F600 is four UTF-8 bytes.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"string\"}]}",
      "value": {
        "v": "😀"
      },
      "expectedHex": "08f09f9880"
    },
    {
      "id": "binary/primitive-encode/bytes-empty",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "Primitive encoding of §3.1.",
