    {
      "id": "binary/primitive-encode/double-negative-2-point-25",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "IEEE 754 binary64, little-endian byte order.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"double\"}]}",
