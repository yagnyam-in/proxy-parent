      "value": {
        "v": -1
      },
      "expectedHex": "01"
    },
    {
      "id": "binary/primitive-encode/long-150",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "Primitive encoding of §3.1.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"long\"}]}",
      "value": {
        "v": 150
      },
      "expectedHex": "ac02"
    },
    {
      "id": "binary/primitive-encode/long-max",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "zigzag(2^63-1) = 2^64-2, ten LEB128 bytes.",
