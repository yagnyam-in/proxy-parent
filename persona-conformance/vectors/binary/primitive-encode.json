      "value": {
        "v": "AQID"
      },
      "expectedHex": "06010203"
    },
    {
      "id": "binary/primitive-encode/bytes-with-high-byte",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "bytes carry raw octets and are never UTF-8 validated.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"bytes\"}]}",
      "value": {
        "v": "AAEC/w=="
      },
      "expectedHex": "08000102ff"
    },
    {
      "id": "binary/primitive-encode/timestamp-epoch",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "Primitive encoding of §3.1.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"timestamp-millis\"}]}",
      "value": {
        "v": "1970-01-01T00:00:00.000Z"
      },
      "expectedHex": "00"
    },
    {
      "id": "binary/primitive-encode/timestamp-150-millis",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "Primitive encoding of §3.1.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"timestamp-millis\"}]}",
      "value": {
        "v": "1970-01-01T00:00:00.150Z"
      },
      "expectedHex": "ac02"
