    {
      "id": "binary/primitive-encode/timestamp-minus-one-millis",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "One millisecond before the epoch: zigzag(-1) = 1.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"timestamp-millis\"}]}",
      "value": {
        "v": "1969-12-31T23:59:59.999Z"
