{
  "vectorFormat": "persona-conformance-vectors",
  "vectorFormatVersion": 1,
  "kind": "payload.binary.encode",
  "description": "Byte-exact persona-binary encodings of the §3.1 primitives. A runner encodes the given value against the given schema and compares the bytes exactly; expected bytes are lowercase hex.",
  "spec": [
    "docs/SCHEMA.md §3.1",
    "docs/SCHEMA.md §3.4 rule 7"
  ],
  "vectors": [
    {
      "id": "binary/primitive-encode/int-zero",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "Primitive encoding of §3.1.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"int\"}]}",
      "value": {
        "v": 0
      },
      "expectedHex": "00"
    },
    {
      "id": "binary/primitive-encode/int-one",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "Primitive encoding of §3.1.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"int\"}]}",
      "value": {
        "v": 1
      },
      "expectedHex": "02"
    },
    {
      "id": "binary/primitive-encode/int-minus-one",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "zigzag(-1) = 1.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"int\"}]}",
      "value": {
        "v": -1
      },
      "expectedHex": "01"
    },
    {
      "id": "binary/primitive-encode/int-64",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "zigzag(64) = 128, LEB128 two bytes: 0x80 0x01 (the low group carries the continuation bit).",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"int\"}]}",
      "value": {
        "v": 64
      },
      "expectedHex": "8001"
    },
    {
      "id": "binary/primitive-encode/int-minus-64",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "zigzag(-64) = 127 = 0x7f, one byte.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"int\"}]}",
      "value": {
        "v": -64
      },
      "expectedHex": "7f"
    },
    {
      "id": "binary/primitive-encode/int-150",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "Primitive encoding of §3.1.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"int\"}]}",
      "value": {
        "v": 150
      },
      "expectedHex": "ac02"
    },
    {
      "id": "binary/primitive-encode/int-max",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "zigzag(2^31-1) = 2^32-2, five LEB128 bytes.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"int\"}]}",
      "value": {
        "v": 2147483647
      },
      "expectedHex": "feffffff0f"
    },
    {
      "id": "binary/primitive-encode/int-min",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "zigzag(-2^31) = 2^32-1, five LEB128 bytes.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"int\"}]}",
      "value": {
        "v": -2147483648
      },
      "expectedHex": "ffffffff0f"
    },
    {
