      "value": {
        "v": "2026-10-10T12:00:00.000Z"
      },
      "expectedHex": "80b8f9daa468"
    },
    {
      "id": "binary/primitive-encode/timestamp-floor",
      "spec": "docs/SCHEMA.md §3.4 rule 7",
