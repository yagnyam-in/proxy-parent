    {
      "id": "binary/primitive-encode/double-smallest-vector-value",
      "spec": "docs/SCHEMA.md §3.1",
      "description": "0.001 is one of the §4.4 values whose shortest representation is implementation-independent.",
      "schema": "{\"type\":\"record\",\"name\":\"Single\",\"fields\":[{\"name\":\"v\",\"type\":\"double\"}]}",
      "value": {
        "v": 0.001
      },
      "expectedHex": "fca9f1d24d62503f"
